{
  "name": "design-architect-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "npm run generate:themes && npm run generate:designs",
    "generate:check": "npm run generate:themes:check && npm run generate:designs:check",
    "generate:themes": "python3 ../scripts/generate_example_themes.py",
    "generate:themes:check": "python3 ../scripts/generate_example_themes.py --check",
    "generate:designs": "python3 ../scripts/generate_example_designs.py",
    "generate:designs:check": "python3 ../scripts/generate_example_designs.py --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
